{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuum-dependency-bench-v1",
  "title": "Continuum Dependency Bench Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "domain",
    "case_class",
    "adversarial_tags",
    "variance_subset",
    "decision_type",
    "task",
    "proposed_outcome",
    "sources",
    "ground_truth",
    "mutation"
  ],
  "properties": {
    "schema_version": {"const": "continuum-dependency-bench-v1"},
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "domain": {
      "enum": ["vendor-onboarding", "production-release", "privileged-access"]
    },
    "case_class": {
      "enum": [
        "clean-positive",
        "clean-negative",
        "critical-omission",
        "irrelevant-distractor",
        "obsolete-revision",
        "conflicting-sources",
        "near-duplicate",
        "prompt-injection",
        "multiple-dependencies",
        "narrow-clause"
      ]
    },
    "adversarial_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "prompt-injection",
          "near-match",
          "obsolete-revision",
          "contradictory-authority",
          "critical-omission"
        ]
      }
    },
    "variance_subset": {"type": "boolean"},
    "decision_type": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "proposed_outcome": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "ground_truth": {"$ref": "#/$defs/ground_truth"},
    "mutation": {"$ref": "#/$defs/mutation"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "artifact_id",
        "artifact_type",
        "logical_key",
        "revision_label",
        "parser_version",
        "logical_path",
        "source_type",
        "trust_class",
        "authority_rank",
        "content",
        "current"
      ],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {
          "enum": ["POLICY", "DOCUMENT", "RECORD", "TOOL_SNAPSHOT", "HUMAN_APPROVAL"]
        },
        "logical_key": {"type": "string", "minLength": 1},
        "revision_label": {"type": "string", "minLength": 1},
        "parser_version": {"type": "string", "minLength": 1},
        "logical_path": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": ["POLICY", "DOCUMENT", "STRUCTURED_RECORD", "TOOL_SNAPSHOT", "HUMAN_APPROVAL"]
        },
        "trust_class": {"enum": ["AUTHORITATIVE", "VERIFIED", "UNTRUSTED"]},
        "authority_rank": {"type": "integer", "minimum": 0},
        "content": {},
        "current": {"type": "boolean"}
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref_a", "source_ref_b", "topic"],
      "properties": {
        "source_ref_a": {"type": "string", "minLength": 1},
        "source_ref_b": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_critical_refs",
        "acceptable_supporting_refs",
        "forbidden_or_irrelevant_refs",
        "expected_outcome_constraints",
        "blocking_contradictions"
      ],
      "properties": {
        "required_critical_refs": {"type": "array", "items": {"type": "string"}},
        "acceptable_supporting_refs": {"type": "array", "items": {"type": "string"}},
        "forbidden_or_irrelevant_refs": {"type": "array", "items": {"type": "string"}},
        "expected_outcome_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_outcomes", "must_block"],
          "properties": {
            "allowed_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "must_block": {"type": "boolean"}
          }
        },
        "blocking_contradictions": {
          "type": "array",
          "items": {"$ref": "#/$defs/contradiction"}
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "mutation_kind",
        "replacement_content",
        "expected_stale_decision_ids",
        "expected_unchanged_decision_ids"
      ],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "mutation_kind": {"type": "string", "minLength": 1},
        "replacement_content": {},
        "expected_stale_decision_ids": {"type": "array", "items": {"type": "string"}},
        "expected_unchanged_decision_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
