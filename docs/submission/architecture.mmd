    subgraph CloudRun["Google Cloud Run · Continuum P0"]
        API["FastAPI control plane"]
        Runtime["Deterministic semantic runtime<br/>Mission state machine · provenance graph<br/>invalidation · commitments · side-effect ledger"]
        Agents["Google ADK agent fleet<br/>Vendor · Security · Procurement"]
        Simulator["Enterprise simulator<br/>vendor · policy · documents"]

        API -->|"validated command"| Runtime
        API -->|"bounded work request"| Agents
        Agents -. "typed proposal + dependency refs" .-> Runtime
        Simulator -->|"normal domain events only"| API
    end

    Agents -->|"reasoning"| Gemini["Vertex AI<br/>Gemini 3.6 Flash"]
    Runtime -->|"transactional aggregate"| Firestore["Firestore Native<br/>Mission source of truth"]
    Runtime -->|"durable outbox"| PubSub["Pub/Sub<br/>domain event transport"]
    API -->|"OpenTelemetry spans"| Trace["Cloud Trace"]

    Optional["P1 optional<br/>Agent Runtime · Registry · Gateway · Model Armor"]
    Agents -. "adopt only when stable" .-> Optional

    Invariant["Critical invariant<br/>Gemini proposes; Continuum owns deterministic invalidation and state transitions"]
    Invariant -.-> Runtime

