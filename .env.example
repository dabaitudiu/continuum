# Default: deterministic local adapters, no model credentials required.
CONTINUUM_AGENT_MODE=local

# Real Google ADK + Gemini execution:
# CONTINUUM_AGENT_MODE=google_adk
# CONTINUUM_GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=replace-with-ai-studio-key

# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-east1
