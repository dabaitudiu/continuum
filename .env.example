# Default: deterministic local adapters, no model credentials required.
CONTINUUM_AGENT_MODE=local

# Live OpenAI dependency benchmark (hard cumulative budget is enforced at $10):
# OPENAI_API_KEY=replace-with-openai-key
# CONTINUUM_OPENAI_MODEL=gpt-5.6-luna
# CONTINUUM_OPENAI_BUDGET_LEDGER=backend/data/openai-benchmark-budget.db

# Semantic Dependency Compiler persistence. Defaults to the runtime store and
# shares CONTINUUM_DB_PATH when SQLite is selected.
CONTINUUM_COMPILER_STORE=sqlite
# CONTINUUM_RUNTIME_COMPILER_CAPABILITY=replace-with-a-long-random-runtime-secret

# Real Google ADK + Gemini execution:
# CONTINUUM_AGENT_MODE=google_adk
# CONTINUUM_GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=replace-with-ai-studio-key

# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Google Cloud runtime (Cloud Run service identity uses ADC automatically):
# CONTINUUM_RUNTIME_STORE=firestore
# CONTINUUM_FIRESTORE_DATABASE=continuum
# CONTINUUM_FIRESTORE_COLLECTION=missions
# CONTINUUM_FIRESTORE_COMPILER_COLLECTION=compiler_requests
# CONTINUUM_PUBSUB_TOPIC=continuum-events
# CONTINUUM_OTEL_EXPORTER=google_cloud_trace
# CONTINUUM_ENVIRONMENT=hackathon
